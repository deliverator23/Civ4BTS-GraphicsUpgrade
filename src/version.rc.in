// Template for build\version.rc (filled in by build.bat). The numbers match the system's 32-bit d3d9.dll, because the
// games check d3d9.dll's file version at startup; the strings say what this DLL really is (GraphicsUpgrade, its
// own version in ProductVersion).
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @VERSION_NUM@
 PRODUCTVERSION @VERSION_NUM@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "GraphicsUpgrade: a graphics add-on for Civilization IV: Beyond the Sword (d3d9 proxy)"
            VALUE "FileVersion", "@VERSION_STR@"
            VALUE "InternalName", "d3d9"
            VALUE "OriginalFilename", "d3d9.dll"
            VALUE "ProductName", "GraphicsUpgrade"
            VALUE "ProductVersion", "@GRAPHICSUPGRADE_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
